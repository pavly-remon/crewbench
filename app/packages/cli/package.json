{
  "name": "crewbench",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavly-remon/crewbench.git",
    "directory": "app/packages/cli"
  },
  "homepage": "https://github.com/pavly-remon/crewbench#readme",
  "bugs": {
    "url": "https://github.com/pavly-remon/crewbench/issues"
  },
  "bin": {
    "crewbench": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b",
    "build:publish": "node scripts/build-publish.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@crewbench/adapters": "workspace:*",
    "@crewbench/contract": "workspace:*",
    "@crewbench/daemon": "workspace:*",
    "@crewbench/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
