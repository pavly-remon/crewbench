{
  "name": "crewbench-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "generate:schemas": "pnpm --filter @crewbench/contract generate:schemas",
    "check:schemas": "pnpm generate:schemas && git diff --exit-code -- ../schemas"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
